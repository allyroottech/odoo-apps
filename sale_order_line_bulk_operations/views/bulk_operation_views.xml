<odoo>
    <record id="view_bulk_operation_list" model="ir.ui.view">
        <field name="name">sale.order.line.bulk.operation.list</field>
        <field name="model">sale.order.line.bulk.operation</field>
        <field name="arch" type="xml">
            <list string="Bulk Operations">
                <field name="name"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="field_name"/>
                <field name="operation_type"/>
                <field name="line_count"/>
                <field name="order_count"/>
                <field name="applied_line_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'partially_reverted'"
                       decoration-muted="state == 'reverted'"
                       decoration-danger="state == 'failed'"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_bulk_operation_form" model="ir.ui.view">
        <field name="name">sale.order.line.bulk.operation.form</field>
        <field name="model">sale.order.line.bulk.operation</field>
        <field name="arch" type="xml">
            <form string="Bulk Operation" create="false" edit="false">
                <header>
                    <button name="action_undo" string="Undo Operation" type="object" class="btn-primary"
                            invisible="state not in ('completed', 'partially_reverted')"
                            groups="sale_order_line_bulk_operations.group_bulk_operations_manager"
                            confirm="This attempts to revert this operation on every line whose value has not changed since. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="field_name"/>
                            <field name="operation_type"/>
                            <field name="value_numeric" invisible="field_name == 'name'"/>
                            <field name="value_text" invisible="field_name != 'name'"/>
                        </group>
                        <group>
                            <field name="line_count"/>
                            <field name="order_count"/>
                            <field name="applied_line_count"/>
                            <field name="skipped_line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Line Changes">
                            <field name="operation_line_ids">
                                <list create="false" delete="false" decoration-muted="reverted">
                                    <field name="order_id"/>
                                    <field name="sale_order_line_id"/>
                                    <field name="old_value_numeric" string="Old Value" column_invisible="parent.field_name == 'name'"/>
                                    <field name="new_value_numeric" string="New Value" column_invisible="parent.field_name == 'name'"/>
                                    <field name="old_value_text" string="Old Text" column_invisible="parent.field_name != 'name'"/>
                                    <field name="new_value_text" string="New Text" column_invisible="parent.field_name != 'name'"/>
                                    <field name="reverted"/>
                                    <field name="skip_reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bulk_operation" model="ir.actions.act_window">
        <field name="name">Bulk Operation History</field>
        <field name="res_model">sale.order.line.bulk.operation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
