<odoo>
    <record id="module_category_sale_order_line_bulk_operations" model="ir.module.category">
        <field name="name">Sale Order Line Bulk Operations</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_bulk_operations" model="res.groups.privilege">
        <field name="name">Sale Order Line Bulk Operations</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="module_category_sale_order_line_bulk_operations"/>
    </record>

    <record id="group_bulk_operations_user" model="res.groups">
        <field name="name">User: Perform Bulk Updates</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_bulk_operations"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_bulk_operations_manager" model="res.groups">
        <field name="name">Manager: View History and Undo</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_bulk_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_bulk_operations_user')), (4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <!-- sale.order.line.bulk.operation: multi-company (global), personal vs manager-sees-all -->
    <record id="sale_order_line_bulk_operation_comp_rule" model="ir.rule">
        <field name="name">Bulk Operation: multi-company</field>
        <field name="model_id" ref="model_sale_order_line_bulk_operation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="sale_order_line_bulk_operation_personal_rule" model="ir.rule">
        <field name="name">Bulk Operation: own records</field>
        <field name="model_id" ref="model_sale_order_line_bulk_operation"/>
        <field name="groups" eval="[(4, ref('group_bulk_operations_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="sale_order_line_bulk_operation_manager_rule" model="ir.rule">
        <field name="name">Bulk Operation: manager sees all</field>
        <field name="model_id" ref="model_sale_order_line_bulk_operation"/>
        <field name="groups" eval="[(4, ref('group_bulk_operations_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- sale.order.line.bulk.operation.line: same pattern, scoped through the parent operation -->
    <record id="sale_order_line_bulk_operation_line_comp_rule" model="ir.rule">
        <field name="name">Bulk Operation Line: multi-company</field>
        <field name="model_id" ref="model_sale_order_line_bulk_operation_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="sale_order_line_bulk_operation_line_personal_rule" model="ir.rule">
        <field name="name">Bulk Operation Line: own records</field>
        <field name="model_id" ref="model_sale_order_line_bulk_operation_line"/>
        <field name="groups" eval="[(4, ref('group_bulk_operations_user'))]"/>
        <field name="domain_force">[('operation_id.user_id', '=', user.id)]</field>
    </record>

    <record id="sale_order_line_bulk_operation_line_manager_rule" model="ir.rule">
        <field name="name">Bulk Operation Line: manager sees all</field>
        <field name="model_id" ref="model_sale_order_line_bulk_operation_line"/>
        <field name="groups" eval="[(4, ref('group_bulk_operations_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
