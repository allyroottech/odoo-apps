<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.AttachmentList" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-AttachmentButtons')]" position="inside">
            <button t-if="canPreviewAttachment(attachment)"
                    class="btn bg-500 w-100 h-100 o-p-1_5 d-flex justify-content-center align-items-center shadow-sm"
                    t-att-class="{ 'ms-2': canDownload(attachment) or showDelete }"
                    t-on-click.stop="() => this.onClickPreviewAttachment(attachment)"
                    title="Preview">
                <i class="fa fa-eye o-text-white" role="img" aria-label="Preview"/>
            </button>
        </xpath>
    </t>
</templates>
