<odoo>
    <record id="sale_order_view_search_ready_to_invoice" model="ir.ui.view">
        <field name="name">sale.order.search.ready.to.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='to_invoice']" position="after">
                <filter string="Delivered, Not Invoiced (7+ days)" name="delivered_not_invoiced_aging"
                        domain="[('invoice_status', '=', 'to invoice'), ('delivery_status', '=', 'full'), ('fully_delivery_date', '&lt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
            </xpath>
        </field>
    </record>
</odoo>
